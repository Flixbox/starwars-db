{
  "name": "starwars-db",
  "author": "Flixbox",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "A Star Wars database webapp",
  "repository": {
    "type": "git",
    "url": "https://github.com/Flixbox/starwars-db"
  },
  "bugs": {
    "url": "https://github.com/Flixbox/starwars-db/issues"
  },
  "homepage": "https://github.com/Flixbox/starwars-db#readme",
  "engines": {
    "bun": ">=1.3.2"
  },
  "scripts": {
    "prestart": "bunx kill-port 3000",
    "start": "next dev",
    "build": "next build",
    "test": "bunx playwright test",
    "lint": "bunx npm-run-all --continue-on-error \"lint:*\"",
    "lint:biome": "bunx @biomejs/biome@2.3.6 check --fix",
    "lint:typecheck": "bunx tsc --noEmit",
    "lint:knip": "knip",
    "lint:pkgjson": "bunx npm-package-json-lint ."
  },
  "dependencies": {
    "@mantine/core": "8.3.10",
    "@mantine/hooks": "8.3.10",
    "next": "16.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@playwright/test": "1.57.0",
    "@types/node": "25.0.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "babel-plugin-react-compiler": "1.0.0",
    "knip": "5.76.0",
    "typescript": "5.9.3"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
